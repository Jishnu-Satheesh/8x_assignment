# Server only. Supply the value directly in ignored .env.local, never in chat.
GOOGLE_GENERATIVE_AI_API_KEY=

# Production is disabled until a durable single-host ledger is configured.
# Vercel/serverless generation remains disabled even with these settings.
# Use the same persistent path across every restart/release on one Node host.
STUDIO_DURABLE_SINGLE_HOST=false
STUDIO_DATA_DIR=
# Exact public origin when behind a TLS reverse proxy, e.g. https://studio.example.com
STUDIO_ORIGIN=
