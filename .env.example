# All secrets stay server-side. Paste values directly in ignored .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Session-pooler URL (5432) for official CLI migrations; never set in the browser.
SUPABASE_DB_URL=
TRIGGER_PROJECT_REF=
# Use a Development key for a local worker, Production only after deployment approval.
TRIGGER_SECRET_KEY=
TRIGGER_PROFILE=default
# Exact origin. Local testing uses http://localhost:3000.
STUDIO_ORIGIN=
ABUSE_PROTECTION_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# CAPTCHA is required by default. Owner-approved assignment opt-out only:
STUDIO_CAPTCHA_MODE=required
# Local-only, never set on a public deployment.
STUDIO_LOCAL_DEVELOPMENT=false
# Keep false until the production worker and public protections are verified.
STUDIO_WORKER_VERIFIED=false
